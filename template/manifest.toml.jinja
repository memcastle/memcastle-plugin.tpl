format = 1
memcastle = "{{ memcastle }}"

[plugin]
id = "{{ plugin_id }}"
version = "{{ version }}"
provider = "{{ provider }}"
description = "{{ description }}"
repository = "https://github.com/{{ github_owner }}/{{ repository_name }}"
license = "MIT"

{% for id in sources %}
[[modules]]
id = "{{ id }}"
type = "source"
version = "{{ version }}"
manifest = "sources/{{ id }}/memcastle-source.toml"
entry = "sources/{{ id }}/source.wasm"
contract = "0.4.0"
{% endfor %}
{% for id in integrations %}
[[modules]]
id = "{{ id }}"
type = "integration"
version = "{{ version }}"
manifest = "integrations/{{ id }}/memcastle-integration.toml"
entry = "integrations/{{ id }}/dist/index.js"
{% endfor %}
[checksums]
