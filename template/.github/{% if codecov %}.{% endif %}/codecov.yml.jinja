coverage:
  status:
    project:
      default:
        target: "{{ codecov_project_target }}"
        threshold: 0%
    patch:
      default:
        target: "{{ codecov_patch_target }}"
        threshold: 0%
{% if sources or integrations %}
# Each flag names the same typed module as the matching CI upload.
# A missing report is not carried forward from an earlier commit.
flags:
{% for id in sources %}
  source-{{ id }}:
    paths: ["sources/{{ id }}/src/**"]
    carryforward: false
{% endfor %}
{% for id in integrations %}
  integration-{{ id }}:
    paths: ["integrations/{{ id }}/src/**"]
    carryforward: false
{% endfor %}

# Components describe actual file ownership, independently of upload flags.
# Modules without native coverage stay visible without becoming failing gates.
component_management:
  individual_components:
{% for id in sources %}
    - component_id: source-{{ id }}
      name: Source {{ id }}
      paths: ["sources/{{ id }}/src/**"]
      statuses:
        - type: project
{% if id in codecov_covered_sources %}
          target: "{{ codecov_source_target }}"
          threshold: 0%
{% else %}
          target: 0%
          informational: true
{% endif %}
{% endfor %}
{% for id in integrations %}
    - component_id: integration-{{ id }}
      name: Integration {{ id }}
      paths: ["integrations/{{ id }}/src/**"]
      statuses:
        - type: project
{% if id in codecov_covered_integrations %}
          target: "{{ codecov_integration_target }}"
          threshold: 0%
{% else %}
          target: 0%
          informational: true
{% endif %}
{% endfor %}
{% endif %}
comment:
  layout: reach,diff,flags,components,files
  require_changes: false
