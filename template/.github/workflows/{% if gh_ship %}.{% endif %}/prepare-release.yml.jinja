name: 🚀 Prepare {{ plugin_id }} release

on:
  workflow_dispatch:
    inputs:
      dry_run:
        type: boolean
        default: false
        required: false

permissions:
  contents: read

jobs:
  prepare:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment:
      name: release
      deployment: false
    steps:
{% if ship_token == "app" %}
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: {% raw %}${{ vars.APP_CLIENT_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
{% endif %}
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
          fetch-tags: true
          token: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
      - uses: jdx/mise-action@v5
        with:
          cache: true
      - uses: memcastle/memcastle/.github/actions/core-binary@main
        with:
          version: main
      - name: Install gh-ship
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh extension install noirbizarre/gh-ship
      - name: Calculate version and release notes
        id: version
        env:
          PLUGIN_ID: {{ plugin_id }}
        run: |
          set -euo pipefail
          last_tag="$(git describe --tags --abbrev=0 --match "$PLUGIN_ID/v*" 2>/dev/null || true)"
          next_tag="$(git cliff --bumped-version)"
          if [[ "$last_tag" == "$next_tag" ]]; then
            echo 'changed=false' >> "$GITHUB_OUTPUT"
            exit 0
          fi
          version="${next_tag#"$PLUGIN_ID/v"}"
          [[ "$next_tag" == "$PLUGIN_ID/v$version" && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
            echo "::error::git-cliff produced an invalid plugin tag: $next_tag"; exit 1;
          }
          {
            echo "changed=true"
            echo "version=$version"
            echo "tag=$next_tag"
          } >> "$GITHUB_OUTPUT"
      - name: Generate release changelog and apply the parent version
        if: {% raw %}${{ steps.version.outputs.changed == 'true' }}{% endraw %}
        env:
          VERSION: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
          GITHUB_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: |
          set -euo pipefail
          git cliff --bump -o CHANGELOG.md
          git cliff --unreleased --bump --strip all -o "$RUNNER_TEMP/ship-notes.md"
          sed -i "0,/^version = \".*\"/s//version = \"$VERSION\"/" manifest.toml
          actual="$("$MEMCASTLE_BIN" plugin inspect plugin.toml --json | jq -r '.plugin.version')"
          test "$actual" = "$VERSION" || { echo '::error::plugin version update failed'; exit 1; }
      - name: Push release commit
        if: {% raw %}${{ steps.version.outputs.changed == 'true' && !inputs.dry_run }}{% endraw %}
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
          git add manifest.toml CHANGELOG.md
          git commit -m "chore(release): {% raw %}${{ steps.version.outputs.version }}{% endraw %}"
          git push origin HEAD
{% if ship_token == "app" %}
      - name: Sign the release commit as the App
        if: {% raw %}${{ steps.version.outputs.changed == 'true' && !inputs.dry_run }}{% endraw %}
        env:
          GH_TOKEN: {% raw %}${{ steps.app-token.outputs.token }}{% endraw %}
        run: gh ship sign
{% endif %}
      - name: Write the release artifact
        env:
          CHANGED: {% raw %}${{ steps.version.outputs.changed }}{% endraw %}
          VERSION: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
          TAG: {% raw %}${{ steps.version.outputs.tag }}{% endraw %}
        run: |
          set -euo pipefail
          if [[ "$CHANGED" == true ]]; then
            jq -n --arg version "$VERSION" --arg tag "$TAG" --rawfile notes "$RUNNER_TEMP/ship-notes.md" \
              '{schemaVersion: 1, changed: true, version: $version, tag: $tag, release: {notes: $notes}}' > ship.release.json
          else
            jq -n '{schemaVersion: 1, changed: false}' > ship.release.json
          fi
      - name: Validate release artifact
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh ship validate ship.release.json
      - uses: actions/upload-artifact@v7
        with:
          name: ship-release
          path: ship.release.json
          if-no-files-found: error
