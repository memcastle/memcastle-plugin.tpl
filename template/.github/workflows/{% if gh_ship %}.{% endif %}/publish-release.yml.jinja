name: 📦 Publish release

on:
  workflow_dispatch:
    inputs:
      tag:
        required: true
        type: string

permissions:
  contents: read

jobs:
  validate:
    name: 🧪 Validate release archive
{% if codecov and (sources or integrations) %}
    permissions:
      contents: read
      id-token: write
{% endif %}
    uses: ./.github/workflows/ci.yaml
    with:
      tag: {% raw %}${{ inputs.tag }}{% endraw %}

  publish:
    needs: validate
    runs-on: ubuntu-latest
    permissions:
      contents: write
    environment:
      name: release
      url: {% raw %}${{ github.server_url }}/${{ github.repository }}/releases/tag/${{ inputs.tag }}{% endraw %}
    steps:
{% if ship_token == "app" %}
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: {% raw %}${{ vars.APP_CLIENT_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
{% endif %}
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag }}{% endraw %}
          fetch-depth: 0
          persist-credentials: false
      - uses: memcastle/memcastle@main
        with:
          version: development
      - name: Require reviewed tag on main and existing draft
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
          TAG: {% raw %}${{ inputs.tag }}{% endraw %}
        run: |
          set -euo pipefail
          expected="$(memcastle plugin inspect --json | jq -er '.plugin.version')"
          [[ "$TAG" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo '::error::invalid release version tag'; exit 1; }
          test "$TAG" = "$expected" || { echo '::error::tag does not match plugin.toml'; exit 1; }
          git fetch origin main
          git merge-base --is-ancestor HEAD origin/main || { echo '::error::tag must be on main'; exit 1; }
          test "$(gh release view "$TAG" --json isDraft --jq .isDraft)" = true
      - uses: actions/download-artifact@v8
        with:
          name: plugin-package
      - name: Upload validated archive
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
          TAG: {% raw %}${{ inputs.tag }}{% endraw %}
        run: |
          set -euo pipefail
          plugin_id="$(memcastle plugin inspect --json | jq -er '.plugin.id')"
          archive="dist/${plugin_id}-${TAG}.tar.gz"
          test -s "$archive"
          checksum="${archive%.tar.gz}.sha256sum"
          test -s "$checksum"
          gh release upload "$TAG" "$archive" "$checksum" --clobber
