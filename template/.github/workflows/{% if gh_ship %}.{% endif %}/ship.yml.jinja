name: 🚢 Ship

on:
  push:
    branches: [main]
  pull_request:
    types: [closed]

permissions:
  contents: read

concurrency:
  group: ship
  cancel-in-progress: false

jobs:
  prepare:
    if: {% raw %}${{ github.event_name == 'push' && github.repository == '{% endraw %}{{ github_owner }}/{{ repository_name }}{% raw %}' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment:
      name: release
      deployment: false
    steps:
{% if ship_token == "app" %}
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: {% raw %}${{ vars.APP_CLIENT_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
{% endif %}
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Install gh-ship
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh extension install noirbizarre/gh-ship
      - name: Prepare release
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh ship prepare

  release:
    if: >-
      {% raw %}${{ github.event_name == 'pull_request' && github.event.pull_request.merged
        && github.event.pull_request.head.ref == 'release/next'
        && github.event.pull_request.head.repo.full_name == github.repository
        && github.repository == '{% endraw %}{{ github_owner }}/{{ repository_name }}{% raw %}' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 50
    environment:
      name: release
      deployment: false
    steps:
{% if ship_token == "app" %}
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: {% raw %}${{ vars.APP_CLIENT_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
{% endif %}
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Install gh-ship
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh extension install noirbizarre/gh-ship
      - name: Publish release
        env:
          GH_TOKEN: {% if ship_token == "app" %}{% raw %}${{ steps.app-token.outputs.token }}{% endraw %}{% else %}{% raw %}${{ secrets.SHIP_TOKEN }}{% endraw %}{% endif %}
        run: gh ship release
