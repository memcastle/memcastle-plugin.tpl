name: 🧩 CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
  workflow_call:
    inputs:
      tag:
        description: Reviewed release tag to build rather than the caller's branch commit
        type: string
        required: false
        default: ''

permissions:
  contents: read

jobs:
{% if sources %}
  source:
    name: 🦀 Source {% raw %}${{ matrix.source }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
{% if codecov %}
      id-token: write
{% endif %}
    strategy:
      fail-fast: false
      matrix:
        source: [{% for id in sources %}"{{ id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag || github.sha }}{% endraw %}
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: wasm32-wasip2
{% if codecov %}
          components: llvm-tools-preview
      - uses: taiki-e/install-action@cargo-llvm-cov
      - uses: taiki-e/install-action@nextest
{% endif %}
      - uses: Swatinem/rust-cache@v2
      - name: Check source formatting and warnings
        env:
          MODULE: {% raw %}${{ matrix.source }}{% endraw %}
        run: |
          cargo fmt --manifest-path "sources/$MODULE/Cargo.toml" --all -- --check
          cargo clippy --manifest-path "sources/$MODULE/Cargo.toml" --locked --target wasm32-wasip2 -- -D warnings
{% if codecov %}
      - name: Run source tests with coverage and JUnit
        id: source-tests
        env:
          MODULE: {% raw %}${{ matrix.source }}{% endraw %}
        run: |
          cd "sources/$MODULE"
          cargo llvm-cov nextest --locked --config-file "$GITHUB_WORKSPACE/.config/nextest.toml" --no-tests=pass --lib
          if grep -q '<testcase' target/nextest/default/junit.xml; then
            mkdir -p coverage
            cargo llvm-cov report --lcov --output-path coverage/lcov.info
            echo 'has_tests=true' >> "$GITHUB_OUTPUT"
          fi
      - uses: codecov/codecov-action@v7
        if: {% raw %}${{ steps.source-tests.outputs.has_tests == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}{% endraw %}
        with:
          files: sources/{% raw %}${{ matrix.source }}{% endraw %}/coverage/lcov.info
          flags: source-{% raw %}${{ matrix.source }}{% endraw %}
          use_oidc: true
          fail_ci_if_error: true
      - uses: codecov/codecov-action@v7
        if: {% raw %}${{ steps.source-tests.outputs.has_tests == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}{% endraw %}
        with:
          files: sources/{% raw %}${{ matrix.source }}{% endraw %}/target/nextest/default/junit.xml
          flags: source-{% raw %}${{ matrix.source }}{% endraw %}
          report_type: test_results
          use_oidc: true
          fail_ci_if_error: true
{% else %}
      - name: Test source natively
        env:
          MODULE: {% raw %}${{ matrix.source }}{% endraw %}
        run: cargo test --manifest-path "sources/$MODULE/Cargo.toml" --locked --lib
{% endif %}
      - name: Build reproducible source component
        env:
          MODULE: {% raw %}${{ matrix.source }}{% endraw %}
        run: |
          set -euo pipefail
          module_dir="$PWD/sources/$MODULE"
          cargo_home="$(realpath "${CARGO_HOME:-$HOME/.cargo}")"
          sysroot="$(rustc --print sysroot)"
          commit="$(rustc --version --verbose | awk '/^commit-hash: / {print $2}')"
          export CARGO_BUILD_RUSTC_WRAPPER=
          unset RUSTFLAGS
          export CARGO_ENCODED_RUSTFLAGS="--remap-path-prefix=$cargo_home=/cargo"$'\x1f'"--remap-path-prefix=$sysroot/lib/rustlib/src/rust=/rustc/$commit"$'\x1f'"--remap-path-prefix=$module_dir=/module"
          cargo build --manifest-path "$module_dir/Cargo.toml" --locked --release --target wasm32-wasip2
          crate="$(cargo metadata --no-deps --format-version 1 --manifest-path "$module_dir/Cargo.toml" | jq -er '.packages[0].targets[] | select(.kind | index("cdylib")) | .name')"
          cp "$module_dir/target/wasm32-wasip2/release/$crate.wasm" "$module_dir/source.wasm"
          mkdir -p "$module_dir/dist"
          cp "$module_dir/source.wasm" "$module_dir/dist/source.wasm"
      - uses: actions/upload-artifact@v7
        with:
          name: source-{% raw %}${{ matrix.source }}{% endraw %}
          path: sources/{% raw %}${{ matrix.source }}{% endraw %}/source.wasm
          if-no-files-found: error

{% endif %}
{% if integrations %}
  integration:
    name: 🔌 Integration {% raw %}${{ matrix.integration }}{% endraw %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
{% if codecov %}
      id-token: write
{% endif %}
    strategy:
      fail-fast: false
      matrix:
        integration: [{% for id in integrations %}"{{ id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag || github.sha }}{% endraw %}
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: '1.4.2'
      - uses: memcastle/memcastle@main
        with:
          version: development
      - name: Format, lint and install integration dependencies
        if: {% raw %}${{ hashFiles(format('integrations/{0}/package.json', matrix.integration)) != '' }}{% endraw %}
        env:
          MODULE: {% raw %}${{ matrix.integration }}{% endraw %}
        run: |
          cd "integrations/$MODULE"
          if [[ -f bun.lock || -f bun.lockb ]]; then bun install --frozen-lockfile; else bun install; fi
          bun run format:check
          bun run lint
{% if codecov %}
      - name: Run integration tests with coverage and JUnit
        if: {% raw %}${{ hashFiles(format('integrations/{0}/package.json', matrix.integration)) != '' }}{% endraw %}
        env:
          MODULE: {% raw %}${{ matrix.integration }}{% endraw %}
        run: |
          cd "integrations/$MODULE"
          bun test --timeout 60000 --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=junit.xml
      - uses: codecov/codecov-action@v7
        if: {% raw %}${{ (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) && hashFiles(format('integrations/{0}/coverage/lcov.info', matrix.integration)) != '' }}{% endraw %}
        with:
          files: integrations/{% raw %}${{ matrix.integration }}{% endraw %}/coverage/lcov.info
          flags: integration-{% raw %}${{ matrix.integration }}{% endraw %}
          use_oidc: true
          fail_ci_if_error: true
      - uses: codecov/codecov-action@v7
        if: {% raw %}${{ hashFiles(format('integrations/{0}/junit.xml', matrix.integration)) != '' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) }}{% endraw %}
        with:
          files: integrations/{% raw %}${{ matrix.integration }}{% endraw %}/junit.xml
          flags: integration-{% raw %}${{ matrix.integration }}{% endraw %}
          report_type: test_results
          use_oidc: true
          fail_ci_if_error: true
{% else %}
      - name: Test integration
        if: {% raw %}${{ hashFiles(format('integrations/{0}/package.json', matrix.integration)) != '' }}{% endraw %}
        env:
          MODULE: {% raw %}${{ matrix.integration }}{% endraw %}
        run: |
          cd "integrations/$MODULE"
          bun test --timeout 60000
{% endif %}
      - name: Build integration assets
        if: {% raw %}${{ hashFiles(format('integrations/{0}/package.json', matrix.integration)) != '' }}{% endraw %}
        env:
          MODULE: {% raw %}${{ matrix.integration }}{% endraw %}
        run: |
          cd "integrations/$MODULE"
          bun run build
      - uses: actions/upload-artifact@v7
        with:
          name: integration-{% raw %}${{ matrix.integration }}{% endraw %}
          path: integrations/{% raw %}${{ matrix.integration }}{% endraw %}/dist/
          if-no-files-found: error
          include-hidden-files: true

{% endif %}
{% if embeddings %}
  embedding:
    name: 🧠 Embedding {% raw %}${{ matrix.embedding }}{% endraw %}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        embedding: [{% for id in embeddings %}"{{ id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag || github.sha }}{% endraw %}
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: wasm32-wasip2
      - uses: Swatinem/rust-cache@v2
      - name: Test and build embedding component
        env:
          MODULE: {% raw %}${{ matrix.embedding }}{% endraw %}
        run: |
          set -euo pipefail
          module_dir="$PWD/embeddings/$MODULE"
          cargo fmt --manifest-path "$module_dir/Cargo.toml" --all -- --check
          cargo test --manifest-path "$module_dir/Cargo.toml" --locked --lib
          cargo clippy --manifest-path "$module_dir/Cargo.toml" --locked --target wasm32-wasip2 -- -D warnings
          cargo build --manifest-path "$module_dir/Cargo.toml" --locked --release --target wasm32-wasip2
          crate="$(cargo metadata --no-deps --format-version 1 --manifest-path "$module_dir/Cargo.toml" | jq -er '.packages[0].targets[] | select(.kind | index("cdylib")) | .name')"
          cp "$module_dir/target/wasm32-wasip2/release/$crate.wasm" "$module_dir/embedding.wasm"
      - uses: actions/upload-artifact@v7
        with:
          name: embedding-{% raw %}${{ matrix.embedding }}{% endraw %}
          path: embeddings/{% raw %}${{ matrix.embedding }}{% endraw %}/embedding.wasm
          if-no-files-found: error

{% endif %}
  package:
    name: 🏗️ Package
{% if sources or integrations or embeddings %}
    needs: [{% if sources %}source{% endif %}{% if sources and integrations %}, {% endif %}{% if integrations %}integration{% endif %}{% if (sources or integrations) and embeddings %}, {% endif %}{% if embeddings %}embedding{% endif %}]
{% endif %}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7
        with:
          ref: {% raw %}${{ inputs.tag || github.sha }}{% endraw %}
          fetch-depth: 0
          fetch-tags: true
      - uses: memcastle/memcastle@main
        with:
          version: development
{% for id in sources %}
      - uses: actions/download-artifact@v8
        with:
          name: source-{{ id }}
          path: sources/{{ id }}/
{% endfor %}
{% for id in integrations %}
      - uses: actions/download-artifact@v8
        with:
          name: integration-{{ id }}
          path: integrations/{{ id }}/dist/
{% endfor %}
{% for id in embeddings %}
      - uses: actions/download-artifact@v8
        with:
          name: embedding-{{ id }}
          path: embeddings/{{ id }}/
{% endfor %}
      - name: Package plugin
        run: memcastle plugin package
      - uses: actions/upload-artifact@v7
        with:
          name: plugin-package
          path: |
            dist/*.tar.gz
            dist/*.sha256sum
            sources/*/source.wasm
          if-no-files-found: error

  validate:
    name: 🧪 Check with Core
    needs: package
    if: {% raw %}${{ always() && needs.package.result == 'success' }}{% endraw %}
    strategy:
      fail-fast: false
      matrix:
        core: [{% if core_versions %}{% for core_ref in core_versions %}"{{ core_ref }}"{% if not loop.last %}, {% endif %}{% endfor %}{% else %}"development"{% endif %}]
    uses: memcastle/memcastle/.github/workflows/plugin-validation.yaml@main
    with:
      artifact-name: plugin-package
      core-version: {% raw %}${{ matrix.core }}{% endraw %}
      plugin-ref: {% raw %}${{ inputs.tag }}{% endraw %}
