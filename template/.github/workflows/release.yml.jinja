      - '{{ plugin_id }}/v*'

permissions:
  contents: write

jobs:
  release:
    uses: memcastle/memcastle/.github/workflows/standalone-plugin-release.yaml@2d36e3521a2fe010ec27a9af72affc0447e3ab53
    with:
      # Add exact plugin-capable stable versions once available; main is always tested.
      core-versions: '[]'
