name: 📦 Publish {{ plugin_id }}

on:
  push:
    tags:
      - '{{ plugin_id }}/v*'

permissions:
  contents: read

jobs:
  validate:
    name: 🧪 Validate {{ plugin_id }}
    uses: ./.github/workflows/ci.yaml

  publish:
    name: 🚀 Publish {{ plugin_id }}
    needs: validate
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: memcastle/memcastle/.github/actions/core-binary@main
        with:
          version: main
      - name: Require a reviewed version tag on main
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          set -euo pipefail
          expected="$($MEMCASTLE_BIN plugin inspect plugin.toml --json | jq -r '.plugin | "\(.id)/v\(.version)"')"
          test "$GITHUB_REF_NAME" = "$expected" || { echo '::error::tag does not match plugin.toml'; exit 1; }
          git fetch origin main
          git merge-base --is-ancestor HEAD origin/main || { echo '::error::tag must be on main'; exit 1; }
          if gh release view "$GITHUB_REF_NAME" >/dev/null 2>&1; then
            echo '::error::release already exists; bump plugin.version before publishing'
            exit 1
          fi
      - uses: actions/download-artifact@v8
        with:
          name: plugin-package
      - name: Publish this provider's validated archive
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          ARCHIVE: {% raw %}${{ needs.validate.outputs.archive }}{% endraw %}
        run: |
          test -s "$ARCHIVE"
          checksum="${ARCHIVE%.tar.gz}.sha256sum"
          test -s "$checksum"
          gh release create "$GITHUB_REF_NAME" "$ARCHIVE" "$checksum" --generate-notes
